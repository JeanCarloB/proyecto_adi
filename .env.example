# ADIministra · variables de entorno
#
# Copie este archivo como .env en la raíz del proyecto y complete los valores:
#   cp .env.example .env
#
# El archivo .env NO se sube al repositorio (está en .gitignore) y Apache
# bloquea su descarga desde el navegador (.htaccess). Nunca escriba aquí
# contraseñas, tokens ni URI reales: este archivo de ejemplo sí es público.

# Cadena de conexión a MongoDB Atlas.
# Se obtiene en Atlas > Database > Connect > Drivers. Reemplace USUARIO y
# CONTRASENA por las credenciales del usuario de base de datos:
#   - en el servidor: el usuario exclusivo de la aplicación
#   - en su computadora: su usuario personal de integrante
# Si la contraseña tiene caracteres especiales (@ : / ? # %), codifíquelos
# en formato URL (por ejemplo @ se escribe %40).
# Para pruebas con MongoDB local puede usar: mongodb://localhost:27017/
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/

# Nombre de la base de datos. El proyecto usa "adi".
# Para pruebas que no toquen los datos compartidos use otra, por ejemplo adi_prueba.
MONGODB_DB=adi

# Clave secreta para firmar los retos del captcha ALTCHA del inicio de sesión.
# OBLIGATORIA: sin ella el login no funciona. Cualquier texto aleatorio de
# 32 caracteres o más.
# Para generar una:  php -r "echo bin2hex(random_bytes(32));"
# Cada instalación usa la suya; nunca suba la real al repositorio.
ALTCHA_HMAC_KEY=

# Caché opcional con Redis para el resumen de ventas. Si REDIS_HOST queda vacío,
# no se usa Redis y todo sale de MongoDB (la aplicación funciona igual).
# En el servidor del curso: el Redis compartido (por ejemplo 127.0.0.1 y 6379).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefijo de todas las claves. El enunciado exige "grupoX:" en el Redis compartido.
REDIS_PREFIJO=grupo4:adi:
